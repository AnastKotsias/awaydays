# Copy this file to `.env` and adjust if needed:  cp .env.example .env
#
# `.env` is git-ignored, this example file is committed. That way a new
# developer knows which variables exist without any secret being published.

# Matches the credentials and port in ../docker-compose.yml
DATABASE_URL="postgresql://awaydays:awaydays@localhost:5433/awaydays?schema=public"

# Port the API listens on
PORT=4000

# Origin allowed to call this API from the browser (the Vite dev server)
CORS_ORIGIN="http://localhost:5173"

NODE_ENV=development
